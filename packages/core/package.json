{
  "name": "@vortspec/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main/index.ts",
      "default": "./src/main/index.ts"
    },
    "./preload": {
      "types": "./src/preload/index.ts",
      "default": "./src/preload/index.ts"
    },
    "./*": {
      "types": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint ok'",
    "build:stamp": "esbuild src/main/canvas/stamp-standalone.ts --bundle --format=esm --platform=node --legal-comments=none --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);' --outfile=resources/vortspec-stamp.mjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ts-morph": "^24.0.0",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.10.0",
    "electron": "^36.4.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
